# ── Supabase (hosted) ────────────────────────────────────────────────────────
# Connection string do Pooler em modo Transaction (porta 6543).
# Em supabase.com → Project Settings → Database → Connection string → "Transaction".
# O username precisa ser `postgres.<PROJECT_REF>` (NÃO só `postgres`).
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<senha>@<region>.pooler.supabase.com:6543/postgres

# Project Settings → API
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role (server-side, NUNCA no client)

# ── Segurança / Admin ────────────────────────────────────────────────────────
# Pepper do HMAC-SHA256 do CPF. **Troque em produção** — se vazar, todos os
# hashes ficam brutáveis (são só ~10⁹ CPFs válidos).
CPF_PEPPER=dev-pepper-change-me

# Admin do painel.
ADMIN_USER=admin
# DEV: defina ADMIN_PASSWORD e o app gera o hash em memória.
ADMIN_PASSWORD=admin123
# PROD: gere com `node scripts/hash-password.js 'sua-senha'` e cole aqui.
# Em NODE_ENV=production o ADMIN_PASSWORD em texto é IGNORADO — só o hash vale.
# ADMIN_PASSWORD_HASH=scrypt$<salt>$<hash>

# Assina cookie de sessão admin + tokens de captcha matemático (fallback).
SESSION_SECRET=dev-session-secret-change-me

# ── Cloudflare Turnstile (anti-bot) ──────────────────────────────────────────
# OBRIGATÓRIO em produção. Sem isso o app cai no captcha matemático, que
# é resolvido por bots/LLMs em milissegundos.
# Test keys que SEMPRE PASSAM (apenas dev local):
#   sitekey: 1x00000000000000000000AA
#   secret : 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Janela de votação (override global, opcional) ────────────────────────────
# Se preenchidos, valem para TODAS as categorias (override). Se vazios, cada
# categoria usa as colunas voting_starts_at / voting_ends_at do banco.
# Formato: ISO 8601 com timezone, ex.: 2026-05-10T19:00:00-03:00
GLOBAL_VOTING_STARTS=
GLOBAL_VOTING_ENDS=

# ── Realtime (SSE) no /admin ─────────────────────────────────────────────────
# Vercel Hobby tem timeout de 10s — SSE não sobrevive. Deixe vazio/false e o
# painel cai em polling (15s). Em Fly.io / Railway / Render com timeouts mais
# longos, defina como "true" para usar Supabase Realtime via SSE.
NEXT_PUBLIC_REALTIME=false

# ── URL canônica ─────────────────────────────────────────────────────────────
# Usada em og:image / twitter:image (precisam ser absolutas).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
